{
  "name": "k8s-sidecar Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "go.testFlags": ["-v"],
        "go.lintTool": "golangci-lint",
        "go.formatTool": "goimports",
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },
  "forwardPorts": [
    8080,
    9090
  ],
  "postCreateCommand": "make deps && go install golang.org/x/tools/cmd/goimports@latest && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest",
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "GOPROXY": "https://goproxy.cn,https://mirrors.aliyun.com/goproxy/,direct",
    "GONOSUMDB": "*",
    "GONOPROXY": "*",
    "CGO_ENABLED": "1"
  }
}
