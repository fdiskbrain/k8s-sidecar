# k8s-sidecar 配置文件示例
# 支持 YAML、JSON、TOML 格式
# 配置优先级: 命令行参数 > 环境变量 > 配置文件 > 默认值

# Kubernetes kubeconfig 文件路径（可选，为空时使用 In-Cluster 模式）
kubeconfig: ""

# 要监控的命名空间列表
# 使用 "*" 表示所有命名空间
namespaces:
  - default
  - production

# Label 选择器 - 只同步带有这些标签的 ConfigMap
labelSelector:
  app: grafana
  type: dashboard

# 配置文件输出目录
outputDir: "/etc/config"

# Informer 重新同步周期
# 支持的时间单位: ns, us (或 µs), ms, s, m, h
resyncPeriod: "10m"

# 日志级别
# 可选值: debug, info, warn, error, fatal
logLevel: "info"
